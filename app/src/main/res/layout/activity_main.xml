<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFE9">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tarjeta superior flotante -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_soft">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_car_outline"
                app:tint="#2E6BE6" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk_semibold"
                android:maxLines="1"
                android:textColor="#17202A"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="#4F5B66"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="Menú"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <!-- Parte inferior: botones flotantes + panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/fabVehicle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_float"
                android:contentDescription="Centrar en el vehículo"
                android:elevation="4dp"
                android:src="@drawable/ic_car_outline"
                app:tint="#2E6BE6" />

            <ImageButton
                android:id="@+id/fabMe"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_float"
                android:contentDescription="Mi ubicación"
                android:elevation="4dp"
                android:src="@drawable/ic_locate_me" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="#5B6670"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCoords"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:maxLines="1"
                        android:textColor="#17202A"
                        android:textIsSelectable="true"
                        app:autoSizeMaxTextSize="26sp"
                        app:autoSizeMinTextSize="15sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:textColor="#17202A"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="km/h"
                        android:textColor="#5B6670"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <TextView android:id="@+id/chipFence" style="@style/StatusChip" />
                <TextView android:id="@+id/chipAuto" style="@style/StatusChip" />
                <TextView android:id="@+id/chipDistance" style="@style/StatusChip" />
                <TextView android:id="@+id/chipWait" style="@style/StatusChip" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="Pedir ubicación ahora"
                android:textAllCaps="false"
                android:textSize="17sp"
                app:backgroundTint="#2E6BE6"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_locate"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/tileCommands" style="@style/Tile" android:layout_marginEnd="4dp">
                    <ImageView style="@style/TileIcon" android:src="@drawable/ic_terminal" />
                    <TextView style="@style/TileLabel" android:text="Comandos" />
                </LinearLayout>

                <LinearLayout android:id="@+id/tileHistory" style="@style/Tile" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                    <ImageView style="@style/TileIcon" android:src="@drawable/ic_clock" />
                    <TextView style="@style/TileLabel" android:text="Historial" />
                </LinearLayout>

                <LinearLayout android:id="@+id/tileFence" style="@style/Tile" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                    <ImageView style="@style/TileIcon" android:src="@drawable/ic_shield" />
                    <TextView style="@style/TileLabel" android:text="Zona" />
                </LinearLayout>

                <LinearLayout android:id="@+id/tileRoute" style="@style/Tile" android:layout_marginStart="4dp">
                    <ImageView style="@style/TileIcon" android:src="@drawable/ic_nav" />
                    <TextView style="@style/TileLabel" android:text="Cómo llegar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
